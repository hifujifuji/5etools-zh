	"Divine Soul|XGE": {
		"name": "神聖之魂",
		"shortName": "Divine Soul",
		"source": "XGE",
		"className": "Sorcerer",
		"classSource": "PHB",
		"_copy": {
			"name": "Sorcerer",
			"shortName": "Sorcerer",
			"source": "XGE",
			"className": "Sorcerer",
			"classSource": "PHB"
		},
		"entries": [
			{
				"type": "quote",
				"entries": [
					"為什麼那麼多天界的東西都有鳥翅膀，而煉獄的東西都有蝙蝠翅膀？這好隨便。應該要有蝙蝠天使才對！"
				],
				"by": "Xanathar"
			}
		],
		"ENG_name": "Divine Soul"
	},
	"Forge Domain|XGE": {
		"name": "熔爐領域",
		"shortName": "Forge",
		"source": "XGE",
		"className": "Cleric",
		"classSource": "PHB",
		"entries": [
			{
				"type": "quote",
				"entries": [
					"我有個會鍛造東西的手下。一個滿手墨漬、字寫得很漂亮的小笨蛋。所以鐵鎚跟火對這個過程有什麼幫助？紙不會被燒掉嗎？喔，火一定是用來封蠟的！"
				],
				"by": "Xanathar"
			}
		],
		"images": [
