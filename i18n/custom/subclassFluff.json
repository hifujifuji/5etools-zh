			}
		],
		"ENG_name": "Forge Domain"
	},
	"Gloom Stalker|XGE": {
		"name": "幽域追蹤者",
		"shortName": "Gloom Stalker",
		"source": "XGE",
		"className": "Ranger",
		"classSource": "PHB",
		"_copy": {
			"name": "Ranger",
			"shortName": "Ranger",
			"source": "XGE",
			"className": "Ranger",
			"classSource": "PHB"
		},
		"entries": [
			{
				"type": "quote",
				"entries": [
					"所以你在黑暗中鬼鬼祟祟？你知道除了人類以外，幾乎所有東西都能在黑暗中看見吧？我們都看得到你。踮腳走路不會讓你變成{@condition invisible}。"
				],
				"by": "Xanathar"
			}
		],
		"ENG_name": "Gloom Stalker"
	},
