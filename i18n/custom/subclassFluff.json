{
	"Arcane Archer|XGE": {
		"name": "奧法射手",
		"shortName": "Arcane Archer",
		"source": "XGE",
		"className": "Fighter",
		"classSource": "PHB",
		"_copy": {
			"name": "Fighter",
			"shortName": "Fighter",
			"source": "XGE",
			"className": "Fighter",
			"classSource": "PHB"
		},
		"entries": [
			{
				"type": "entries",
				"entries": [
					{
						"type": "quote",
						"entries": [
							"箭矢最糟糕了。它們飛得比眼射線遠多了。所以我一直待在室內。再說，天空根本被高估了。"
						],
						"by": "Xanathar"
					},
					{
						"type": "quote",
						"entries": [
							"所以揮劍的人還分成不同的名字？為什麼？我來試試：大揮劍人跟小揮劍人。不對，這聽起來像是劍的大小才重要。那這樣呢：拿著劍的大肉袋跟拿著劍的小肉袋！"
						],
						"by": "Xanathar"
					}
				]
			}
		],
		"ENG_name": "Arcane Archer"
	},
	"Circle of Dreams|XGE": {
		"name": "夢境結社",
		"shortName": "Dreams",
		"source": "XGE",
		"className": "Druid",
		"classSource": "PHB",
		"entries": [
			{
				"type": "quote",
				"entries": [
