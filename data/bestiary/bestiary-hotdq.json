Rezmir","isNpc":true,"isNamedCreature":true,"source":"HotDQ","page":93,"otherSources":[{"source":"ToD","page":180}],"referenceSources":["RoT"],"size":["M"],"type":{"type":"humanoid","tags":["half-black dragon"]},"alignment":["N","E"],"ac":[13,{"ac":15,"condition":"配戴黑龍面具時","braces":true}],"hp":{"average":90,"formula":"12d8 + 36"},"speed":{"walk":30},"str":18,"dex":16,"con":16,"int":15,"wis":12,"cha":14,"save":{"dex":"+6","wis":"+4"},"skill":{"arcana":"+5","stealth":"+9"},"senses":["blindsight 10 ft.","darkvision 120 ft."],"passive":11,"immune":["acid"],"conditionImmune":["charmed","frightened"],"languages":["Common","Draconic","Infernal","Giant","Netherese"],"cr":"7","trait":[{"name":"Special Equipment","entries":["瑞茲米爾擁有{@item Black Dragon Mask|hotdq|黑龍面具}、{@item Hazirawn|hotdq|哈齊朗}與一枚{@item insignia of claws|hotdq|利爪徽記}。"],"name_zh":"特殊裝備","_zhOf":"Special Equipment"},{"name":"Amphibious","entries":["瑞茲米爾可以在空氣與水中呼吸。"],"name_zh":"兩棲","_zhOf":"Amphibious"},{"name":"Dark Advantage","entries":["每回合一次，只要瑞茲米爾的攻擊檢定具有優勢，它以武器攻擊命中時可以額外造成 10（{@damage 3d6}）傷害。"],"name_zh":"黑暗優勢","_zhOf":"Dark Advantage"},{"name":"Draconic Majesty","entries":["未著甲且配戴黑龍面具時，瑞茲米爾將她的魅力加值加到 AC 上（已計入）。"],"name_zh":"龍之威嚴","_zhOf":"Draconic Majesty"},{"name":"Immolation","entries":["瑞茲米爾的生命值降至 0 時，她的身體會崩解成一堆灰燼。"],"name_zh":"燔焚術","_zhOf":"Immolation"},{"name":"Legendary Resistance (1/Day)","entries":["若瑞茲米爾配戴黑龍面具時豁免檢定失敗，她可以選擇改為成功。"],"name_zh":"傳奇抗性（每日 1 次）","_zhOf":"Legendary Resistance (1/Day)"}],"action":[{"name":"Greatsword (Hazirawn)","entries":["{@atk mw} 命中 {@hit 9}，觸及 5 呎，單一目標。{@h}13（{@damage 2d6 + 6}）劈砍傷害外加 7（{@damage 2d6}）死靈傷害。若目標是生物，它在 1 分鐘內無法恢復生命值。目標可以在其每個回合結束時進行一次 {@dc 15} 體質豁免檢定，成功則提前結束此效應。"],"name_zh":"巨劍（哈齊朗）","_zhOf":"Greatsword (Hazirawn)"},{"name":"Caustic Bolt","entries":["{@atk rs} 命中 {@hit 8}，射程 90 呎，單一目標。{@h}18（{@damage 4d8}）酸蝕傷害。"],"name_zh":"腐蝕箭","_zhOf":"Caustic Bolt"},{"name":"Acid Breath {@recharge 5}","entries":["瑞茲米爾吐出一道長 30 呎、寬 5 呎的直線強酸。直線內的每個生物必須進行一次 {@dc 14} 敏捷豁免檢定，豁免失敗受到 22（{@damage 5d8}）酸蝕傷害，成功則傷害減半。"],"name_zh":"強酸吐息 {@recharge 5}","_zhOf":"Acid Breath {@recharge 5}"}],"legendaryHeader":["若配戴著黑龍面具，瑞茲米爾可以在她的每個回合之間採取至多兩個傳奇動作，可以一次全部採取，也可以分散在整輪中。傳奇動作只能在一個回合的開始或結束時採取。"],"legendaryActions":2,"legendary":[{"name":"Darkness (Costs 2 Actions)","entries":["魔法黑暗從瑞茲米爾 60 呎內她看得見的一點向外擴展半徑 15 呎，並會繞過轉角。只要瑞茲米爾維持{@status concentration||專注}，黑暗便持續存在，至多 1 分鐘。擁有黑暗視覺的生物無法看穿這片黑暗，自然光也無法照亮它。若此區域的任何部分與 2 環或更低法術創造的光照區域重疊，創造該光照的法術會被解除。"],"name_zh":"黑暗（消耗 2 個動作）","_zhOf":"Darkness (Costs 2 Actions)"},{"name":"Melee Attack","entries":["瑞茲米爾進行一次近戰攻擊。"],"name_zh":"近戰攻擊","_zhOf":"Melee Attack"},{"name":"Hide","entries":["瑞茲米爾採取{@action Hide||躲藏}動作。"],"name_zh":"躲藏","_zhOf":"Hide"}],"attachedItems":["greatsword|phb"],"traitTags":["Amphibious","Legendary Resistances"],"senseTags":["B","SD"],"actionTags":["Breath Weapon"],"languageTags":["C","DR","GI","I","OTH"],"damageTags":["A","N","S"],"miscTags":["AOE","MLW","MW"],"savingThrowForced":["constitution","dexterity"],"hasToken":true,"hasFluffImages":true,"name_zh":"瑞茲米爾","_zhOf":"Rezmir"},{"name":"Sandesyl Morgia","isNpc":true,"isNamedCreature":true,"source":"HotDQ","page":81,"otherSources":[{"source":"ToD","page":98}],"_copy":{"name":"Vampire","source":"MM","_mod":{"*":{"mode":"replaceTxt","replace":"the vampire","with":"Sandesyl","flags":"i"}}},"hasToken":true,"hasFluffImages":true,"name_zh":"桑德希爾·莫吉亞","_zhOf":"Sandesyl Morgia"},{"name":"Talis the White","isNpc":true,"isNamedCreature":true,"source":"HotDQ","page":93,"otherSources":[{"source":"ToD","page":189}],"referenceSources":["RoT"],"size":["M"],"type":{"type":"humanoid","tags":["half-elf"]},"alignment":["L","E"],"ac":[{"ac":18,"from":["{@item +1 scale mail}","{@item shield|phb|盾牌}"]}],"hp":{"average":58,"formula":"9d8 + 18"},"speed":{"walk":30},"str":14,"dex":12,"con":14,"int":10,"wis":16,"cha":16,"save":{"wis":"+6","cha":"+6"},"skill":{"deception":"+6","insight":"+6","perception":"+6","persuasion":"+6"},"senses":["darkvision 60 ft."],"passive":16,"languages"