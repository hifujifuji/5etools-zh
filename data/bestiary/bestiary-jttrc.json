luffImages":true,"name_zh":"修蕾","_zhOf":"Sholeh"},{"name":"Soul Shaker","source":"JttRC","page":47,"size":["L"],"type":"undead","alignment":["C","E"],"alignmentPrefix":"typically ","ac":[{"ac":13,"from":["天生護甲"]}],"hp":{"average":76,"formula":"8d10 + 32"},"speed":{"walk":20},"str":20,"dex":8,"con":18,"int":8,"wis":11,"cha":14,"senses":["blindsight 60 ft. (blind beyond this radius)"],"passive":10,"resist":["necrotic"],"immune":["poison"],"conditionImmune":["charmed","exhaustion","frightened","grappled","paralyzed","petrified","poisoned","prone","restrained"],"languages":["telepathy 60 ft."],"cr":"4","trait":[{"name":"Enthralled Lure (1/Day)","entries":["撼魂者可以施展{@spell geas||指使術}法術，無需法術構材，並以魅力作為施法屬性（法術豁免 {@dc 12}）。"],"name_zh":"迷魂誘餌（每日 1 次）","_zhOf":"Enthralled Lure (1/Day)"},{"name":"Reconstruction","entries":["撼魂者的生命值降至 0 時，它爆裂成 7（{@dice 1d4 + 5}）隻爬行爪。6（{@dice 1d12}）天後，若這些爬行爪中至少有兩隻存活，牠們會傳送到撼魂者的死亡地點並融合在一起，撼魂者隨即重新成形並回復所有生命值。"],"name_zh":"重建","_zhOf":"Reconstruction"},{"name":"Unusual Nature","entries":["撼魂者不需要空氣、食物、飲水或睡眠。"],"name_zh":"異常本質","_zhOf":"Unusual Nature"}],"action":[{"name":"Crushing Grasp","entries":["{@atk mw} 命中 {@hit 7}，觸及 5 呎，單一目標。{@h}14（{@damage 2d8 + 5}）鈍擊傷害。若目標是中型或更小的生物，它會陷入{@condition grappled||被擒}狀態（脫逃 {@dc 15}）。撼魂者一次只能以此方式{@condition grappled||擒抱}一個生物。"],"name_zh":"碾壓之握","_zhOf":"Crushing Grasp"}],"bonus":[{"name":"Consume Vitality","entries":["撼魂者以一個正被它擒抱的生物為目標。若目標不是構裝體或不死生物，目標必須成功通過一次 {@dc 14} 體質豁免檢定，否則受到 7（{@damage 2d6}）死靈傷害。目標的生命值上限減少等同於所受死靈傷害的數值，且撼魂者恢復等同於該數值的生命值。此減少效應持續到目標完成一次長休為止。若目標的生命值上限降至 0，它便會死亡。"],"name_zh":"吞噬活力","_zhOf":"Consume Vitality"}],"traitTags":["Unusual Nature"],"senseTags":["B"],"languageTags":["TP"],"damageTags":["B","N"],"miscTags":["HPR","MW"],"conditionInflict":["grappled"],"savingThrowForced":["constitution"],"hasToken":true,"hasFluff":true,"hasFluffImages":true,"name_zh":"撼魂者","_zhOf":"Soul Shaker"},{"name":"Tlacatecolo","source":"JttRC","page":65,"size":["M"],"type":{"type":"fiend","tags":["demon"]},"alignment":["N","E"],"alignmentPrefix":"typically ","ac":[13],"hp":{"average":78,"formula":"12d8 + 24"},"speed":{"walk":30,"fly":30},"str":12,"dex":17,"con":14,"int":10,"wis":15,"cha":10,"save":{"dex":"+6","con":"+5"},"skill":{"perception":"+5","stealth":"+6"},"senses":["darkvision 120 ft."],"passive":15,"resist":["cold","poison"],"conditionImmune":["poisoned"],"languages":["Abyssal","Common"],"cr":"5","trait":[{"name":"Magic Resistance","entries":["特拉卡特科洛對抗法術與其他魔法效應的豁免檢定具有優勢。"],"name_zh":"魔法抗性","_zhOf":"Magic Resistance"}],"action":[{"name":"Multiattack","entries":["特拉卡特科洛進行兩次利爪攻擊。"],"name_zh":"多重攻擊","_zhOf":"Multiattack"},{"name":"Talon","entries":["{@atk mw} 命中 {@hit 6}，觸及 5 呎，單一目標。{@h}8（{@damage 1d8 + 3}）穿刺傷害外加 14（{@damage 3d8}）毒素傷害。"],"name_zh":"利爪","_zhOf":"Talon"},{"name":"Change Shape","entries":["特拉卡特科洛以魔法變成一隻中型貓頭鷹，同時保留自己的遊戲數據（體型除外）。若特拉卡特科洛的生命值降至 0，或它用動作結束它，這次變形便告結束。"],"name_zh":"變形","_zhOf":"Change Shape"},{"name":"Plague Winds (Fiend Form Only; Recharge 5-6)","entries":["特拉卡特科洛朝一條長 60 呎、寬 10 呎的直線吹出一陣冰冷而充滿疾病的風。該區域內的每個生物必須成功通過一次 {@dc 13} 體質豁免檢定，否則受到 26（{@damage 4d12}）寒冰傷害並陷入{@condition poisoned||中毒}狀態。","以此方式{@condition poisoned||中毒}期間，該生物無法恢復生命值。每小時結束時，該生物必須成功通過一次 {@dc 13} 體質豁免檢定，否則獲得 1 級{@condition exhaustion||力竭}。若該生物進行此豁免檢定時處於陽光直射下，豁免自動成功。","若該生物在未處於陽光直射下時成為能終結毒素或疾病的魔法（例如次級復原術）的目標，此效應不會結束。"],"name_zh":"瘟疫之風（僅限邪魔形態；充能 5–6）","_zhOf":"Plague Winds (Fiend Form Only; Recharge 5-6)"}],"traitTags":["Magic Resistance"],"senseTags":["SD"],"actionTags":["Multiattack","Shapechanger"],"languageTags":["AB","C"],"damageTags":["C","I","P"],"miscTags":["AOE","DIS","MW"],"conditionInflict":["exhaustion","poisoned"],"savingThrowForced":["constitution"],"hasToken":true,"hasFluff":true,"hasFluffImages":true,"name_zh":"特拉卡特科洛","_zhOf":"Tlacatecolo"},{"name":"Tlexolotl","source":"JttRC","page":119,"size":["H"],"type":"elemental","alignment":["N"],"alignmentPrefix":"typically ","ac":[{"ac":15,"from":["天生護甲"]}],"hp":{"average":104,"formula":"11d12 + 33"},"speed":{"walk":40},"str":25,"dex":10,