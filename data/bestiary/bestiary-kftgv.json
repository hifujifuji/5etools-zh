ype":"humanoid","tags":["elf"]},"alignment":["L","G"],"tokenCustom":true,"hasToken":true,"name_zh":"奈薇絲·薩瑞索","_zhOf":"Naevys Tharesso"},{"name":"Nixylanna Vidorant","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":130,"_copy":{"name":"Assassin","source":"MM","_mod":{"*":{"mode":"replaceTxt","replace":"the Assassin","with":"Nixylanna Vidorant","flags":"i"}}},"type":{"type":"humanoid","tags":["elf"]},"alignment":["C","N"],"hasToken":true,"hasFluffImages":true,"name_zh":"妮希蘭娜·維多倫特","_zhOf":"Nixylanna Vidorant"},{"name":"Prisoner 13","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":68,"size":["M"],"type":{"type":"humanoid","tags":["dwarf","monk"]},"alignment":["N","E"],"ac":[{"ac":17,"from":["山嶽刺青"]}],"hp":{"average":102,"formula":"12d8 + 48"},"speed":{"walk":30},"str":15,"dex":17,"con":18,"int":16,"wis":14,"cha":16,"save":{"con":"+7","wis":"+5"},"skill":{"athletics":"+5","deception":"+9","insight":"+5","perception":"+5","stealth":"+6"},"senses":["darkvision 60 ft."],"passive":15,"resist":["poison"],"immune":["psychic"],"conditionImmune":["charmed"],"languages":["Common","Dwarvish","Elvish","Thieves' cant","Undercommon"],"cr":"5","trait":[{"name":"Antimagic Susceptibility","entries":["在反魔法區域中，13 號囚犯的刺青與反應無法運作，且她的數據會有下列變動：AC 變為 13、失去對精神傷害與魅惑狀態的免疫，且她的刺青打擊變成命中時造成 7（{@damage 1d8 + 3}）鈍擊傷害的近戰攻擊。"],"name_zh":"反魔法弱點","_zhOf":"Antimagic Susceptibility"},{"name":"Mindlink Tattoos","entries":["13 號囚犯與數十名在各地活動的特務有心靈感應連結。只要雙方位於同一個存在位面，這些連結讓13 號囚犯能與每名特務以心靈感應交流。"],"name_zh":"心靈連結刺青","_zhOf":"Mindlink Tattoos"},{"name":"Mountain Tattoo","entries":["13 號囚犯的 AC 包含其體質調整值。"],"name_zh":"山嶽刺青","_zhOf":"Mountain Tattoo"},{"name":"Shroud Tattoo","entries":["13 號囚犯無法成為預言系法術或任何讀取思緒之特性的目標，也無法被魔法探知感應器察覺。除非它允許，否則無法以心靈感應與它接觸。"],"name_zh":"遮蔽刺青","_zhOf":"Shroud Tattoo"}],"action":[{"name":"Multiattack","entries":["13 號囚犯進行兩次刺青打擊攻擊。"],"name_zh":"多重攻擊","_zhOf":"Multiattack"},{"name":"Tattooed Strike","entries":["{@atk mw,rw} 命中 {@hit 6}，觸及 5 呎或射程 60 呎，單一目標。{@h}12（{@damage 2d8 + 3}）力場傷害。"],"name_zh":"刺青打擊","_zhOf":"Tattooed Strike"},{"name":"Firestorm Tattoo {@recharge 5}","entries":["13 號囚犯以魔法從橫跨背部的刺青釋放火焰，充滿以她為中心、半徑 20 呎的球體。該區域內的每個其他生物必須進行一次 {@dc 15} 敏捷豁免檢定。豁免失敗的生物受到 13（{@damage 3d8}）火焰傷害並被擊倒而{@condition prone||伏地}。豁免成功時，它受到一半傷害且不會被擊倒而{@condition prone||伏地}。"],"name_zh":"火風暴刺青 {@recharge 5}","_zhOf":"Firestorm Tattoo {@recharge 5}"},{"name":"River Tattoo","entries":["13 號囚犯以魔法結束所有使自己陷入{@condition grappled||被擒}或{@condition restrained||束縛}狀態的效應。若它被非魔法的束具綁住，會從中滑脫。"],"name_zh":"河流刺青","_zhOf":"River Tattoo"}],"reaction":[{"name":"Readiness","entries":["當13 號囚犯自身 60 呎內一個它能看見的生物結束其回合時，13 號囚犯進行一次刺青打擊攻擊或使用河流刺青。之後她可以移動至多等同其速度的距離，且不會引發藉機攻擊。"],"name_zh":"戒備","_zhOf":"Readiness"}],"traitTags":["Antimagic Susceptibility"],"senseTags":["D"],"actionTags":["Multiattack"],"languageTags":["C","D","E","TC","U"],"damageTags":["B","F","O"],"miscTags":["AOE","MW","RW"],"conditionInflict":["prone"],"savingThrowForced":["dexterity"],"hasToken":true,"hasFluff":true,"hasFluffImages":true,"name_zh":"13 號囚犯","_zhOf":"Prisoner 13"},{"name":"Rilago","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":147,"_copy":{"name":"Ghost","source":"MM","_mod":{"*":{"mode":"replaceTxt","replace":"the ghost","with":"Rilago","flags":"i"}}},"hasToken":true,"hasFluffImages":true,"name_zh":"里拉戈","_zhOf":"Rilago"},{"name":"Sabrina Kilgore (Levels 1-4)","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":8,"_copy":{"name":"Bandit","source":"MM","_mod":{"*":{"mode":"replaceTxt","replace":"the bandit","with":"Sabrina Kilgore","flags":"i"}}},"type":{"type":"humanoid","tags":["human"]},"alignment":["C","N"],"tokenCustom":true,"hasToken":true,"name_zh":"莎賓娜·基爾戈（1–4 級）","_zhOf":"Sabrina Kilgore (Levels 1-4)"},{"name":"Sabrina Kilgore (Levels 5-8)","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":8,"_copy":{"name":"Thug","source":"MM","_mod":{"*":{"mode":"replaceTxt","replace":"the thug","with":"Sabrina Kilgore","flags":"i"}}},"type":{"type":"humanoid","tags":["human"]}