 Tockworth","isNpc":true,"isNamedCreature":true,"source":"KftGV","page":85,"size":["S"],"type":{"type":"humanoid","tags":["gnome"]},"alignment":["C","E"],"ac":[{"ac":17,"from":["天生護甲","{@item shield|PHB|盾牌}"]}],"hp":{"average":75,"formula":"10d6 + 40"},"speed":{"walk":30},"str":16,"dex":13,"con":18,"int":17,"wis":9,"cha":10,"save":{"int":"+6","wis":"+2"},"skill":{"arcana":"+9","perception":"+2"},"senses":["truesight 60 ft."],"passive":12,"languages":["Common","Gnomish","Terran","Undercommon"],"cr":"7","spellcasting":[{"name":"Spellcasting","type":"spellcasting","headerEntries":["塔克沃斯施展下列法術之一，無需材料構材，以智力作為施法屬性（法術豁免 {@dc 14}）："],"will":["{@spell nondetection||迴避偵測}（僅限自身）"],"daily":{"2":["{@spell dimension door||次元門}"],"1e":["{@spell blindness/deafness||目盲/耳聾術}","{@spell blur||朦朧術}"]},"ability":"int","displayAs":"action","name_zh":"施法","_zhOf":"Spellcasting"}],"trait":[{"name":"Force Field","entries":["塔克沃斯在自身周圍產生一道魔法力場。這道力場有 15 點生命值，並在塔克沃斯每個回合開始時回復所有生命值，但若塔克沃斯的生命值降至 0，力場便停止運作。塔克沃斯受到的任何傷害都先從力場的生命值中扣除。力場每次回復生命值時，塔克沃斯身上的下列狀態便會結束：{@condition grappled||被擒}、{@condition restrained||束縛}與{@condition stunned||震懾}。"],"name_zh":"力場","_zhOf":"Force Field"}],"action":[{"name":"Multiattack","entries":["塔克沃斯進行三次短劍或閃電釋放攻擊。"],"name_zh":"多重攻擊","_zhOf":"Multiattack"},{"name":"Shortsword","entries":["{@atk mw} 命中 {@hit 6}，觸及 5 呎，單一目標。{@h}6（{@damage 1d6 + 3}）穿刺傷害外加 10（{@damage 3d6}）力場傷害。"],"name_zh":"短劍","_zhOf":"Shortsword"},{"name":"Lightning Discharge","entries":["{@atk rs} 命中 {@hit 6}，射程 60 呎，單一生物。{@h}16（{@damage 3d10}）閃電傷害。"],"name_zh":"閃電釋放","_zhOf":"Lightning Discharge"}],"bonus":[{"name":"Scalding Steam {@recharge 5}","entries":["塔克沃斯朝 15 呎錐形區域噴出一道滾燙的蒸汽。該錐形範圍內的每個生物必須進行一次 {@dc 15} 敏捷豁免檢定，豁免失敗受到 10（{@damage 3d6}）火焰傷害，成功則傷害減半。"],"name_zh":"滾燙蒸汽 {@recharge 5}","_zhOf":"Scalding Steam {@recharge 5}"}],"attachedItems":["shortsword|phb"],"senseTags":["U"],"actionTags":["Multiattack"],"languageTags":["C","G","T","U"],"damageTags":["F","L","O","P"],"damageTagsSpell":["O"],"spellcastingTags":