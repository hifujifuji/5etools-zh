[["夸力許裝置",null,null,"作為載具使用時，裝置需要一名駕駛員。裝置的艙門關閉時，艙室氣密且防水。艙室內的空氣足夠呼吸 10 小時，除以艙內會呼吸的生物數量。",null,null,null,"拉桿","上推","下拉",null,null,"前方窗板打開。","前方窗板關閉。","側面窗板打開（每側兩片）。","側面窗板關閉（每側兩片）。",null,"巨螯收回。",null,null,null,null,null,null,null,"燈光熄滅。",null,null,"後艙門解封並打開。","後艙門關閉並密封。"],["夸力許裝置",null,"此物品乍看是一個重 500 磅、密封的鐵桶。桶上有一個隱藏的卡榫，成功通過一次 {@dc 20} 智力（{@skill Investigation|XPHB}）檢定即可找到。打開卡榫會解鎖桶一端的艙門，讓兩個中型或更小的生物爬進去。另一端設有一排十根拉桿，每根都處於中立位置，可以上推或下拉。使用某些拉桿時，裝置會變形成一隻巨大的龍蝦。","作為載具使用時，裝置需要一名駕駛員。裝置的艙門關閉時，艙室氣密且防水。艙室內的空氣足夠呼吸 10 小時，除以艙內會呼吸的生物數量。","裝置能浮在水面上，也能潛入水下至多 900 呎深。在更深處，載具每分鐘會因水壓受到 {@damage 2d6} 鈍擊傷害。","艙室內的生物可以執行一個{@action Utilize|XPHB}動作，將裝置的至多兩根拉桿上推或下拉。每次使用後，拉桿會回到中立位置。各拉桿由左至右的功能如「夸力許裝置拉桿」表所示。","夸力許裝置拉桿","拉桿","上推","下拉","腿伸出，使裝置能夠行走和游泳。","腿收回，使裝置的{@variantrule Speed|XPHB}與{@variantrule Swim Speed|XPHB}降為 0，且無法從速度加值中獲益。","前方窗板打開。","前方窗板關閉。","側面窗板打開（每側兩片）。","側面窗板關閉（每側兩片）。","裝置前方伸出兩支巨螯。","巨螯收回。",null,null,"若腿已伸出，裝置向前行走或游動。","若腿已伸出，裝置向後行走或游動。","若腿已伸出，裝置逆時針轉動 90 度。","若腿已伸出，裝置順時針轉動 90 度。","眼狀裝置在 30 呎半徑內發出{@variantrule Bright Light|XPHB}，並在其外額外 30 呎發出{@variantrule Dim Light|XPHB}。","燈光熄滅。","若裝置位於液體中，下沉至多 20 呎。","若裝置位於液體中，上升至多 20 呎。","後艙門解封並打開。","後艙門關閉並密封。"],[null,null,null],[null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"移動",null,null,null],["射石砲艦",null,null,null,null,"弩矢",null,null,null,null,null,"砲彈",null],["豆娘船","弩砲",null,null,null,"弩矢",null,"彈射投石機",null,null,null,"彈射投石",null],[null,null,null,"魔法武器",null,"倒地缺陷",null,null,null,null,null,null,null,null,null],[null,"跳躍術",null,"倒地缺陷",null,null,null,null,null,null,null],["飛魚船","弩砲",null,null,null,"弩矢",null,"彈射投石機",null,null,null,"彈射投石",null],["槳帆船",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"移動",null],["錘頭鯊船","弩砲",null,null,null,"弩矢",null,null,null,null,null,"彈射投石",null,null,null,null,null,null],["龍骨船",null,null,null,"20 呎",null,null,"弩砲",null,null,null,null,"移動",null],["七鰓鰻船",null,null,null,null,"弩矢",null,null,null,null,null,null],["活體船","弩砲",null,null,null,"弩矢",null],["維京