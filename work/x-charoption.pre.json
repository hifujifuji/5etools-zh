[[null,null,null,null,null,null],[null,null,"構裝韌性","你被創造出來擁有非凡的堅韌，表現為下列益處：","你對抗{@condition poisoned}的豁免檢定具有優勢，並具有毒素傷害抗性。","你不需要進食、飲水或呼吸。","你對疾病免疫。","你不需要睡眠，魔法也無法使你入睡。","哨兵休息","進行長休時，你必須在不活動、靜止不動的狀態下度過至少六小時，而非睡眠。在此狀態下，你看起來毫無動靜，但這不會使你{@condition unconscious}，且你能正常看見與聽見。",null,"d6","特徵",null,null,null,null,null,null],[null,null],[null,null],["二重身",null,null],[null,null],[null,null],[null,null,null,null,"d6",null,null,null,null,null,null,null,null,"你獲得兩項自選技能的熟練。",null,null,null,null,null,"d6","效果",null,null,null,null,null,null],[null,null],[null,null],[null,null,null,null,"d6","戰士之靈",null,null,null,null,null,null,null,null,null,null,null,null,null,"d4","效果",null,null,null,null],[null,null,"違抗死亡","你的死亡豁免檢定具有優勢。",null,null,null,"d6","命運",null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,"{@i 5th-level Iconoclast trait}",null,null,"{@i 11th-level Iconoclast trait}",null,null,null,"{@i 17th-level Iconoclast trait}",null,null,null,"d6","特徵",null,null,null,null,null,null],["繼承者",null,null],["莫測高深",null,null,"你具有心靈傷害抗性。",null,null,null,"d6","特徵",null,null,null,null,null,null],[null,null,null,null,null,null,null,"d6",null,null,null,null,null,null,null],[null,null],["活體陰影",null,null,null,"d6","怪癖",null,null,null,null,null,null,null,null,"暗影打擊",null,null,null],[null,null],[null,null,null,null,"d4","身世",null,null,null,null,"迷蹤步",null,null,null,null,null],[null,null],[null,null,null,null,null,null,null,null,"你擁有死靈與光耀傷害的抗性。",null,"d6","身世",null,null,null,null,null,null,null,"d6","怪癖",null,null,null,null,null,null],[null,null],["神諭者",null,null,null,null,null,null,null,null,null,null,null,"{@i Piety 3+ Oracle trait}",null,"先知","{@i Piety 10+ Oracle trait}",null,null,"{@i Piety 25+ Oracle trait}",null,null,null,"{@i Piety 50+ Oracle trait}",null,null,"d8","缺點",null,null,null,null,null,null,null,null],["獸人石","我救了一個獸人的命，他給了我一顆刻有萬箭部落標誌（一顆被三支箭貫穿的類人頭骨）的石頭。這顆石頭是一件需要同調的非普通魔法物品，而且只有我能與它同調。",null,null],[null,null,null],[