[[null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null],[null,null,null],[null,null,null,null,null,null,null,null],["棕黴菌",null,null,null],[null,null,null],[null,null],[null,null],["惡魔膿血",null,null,null,null,null,"血肉扭曲","d100","效果","目標的頭髮、眼睛與皮膚的顏色變成藍色、紅色、黃色或帶有花紋。",null,"目標的手長出爪子，可以當作匕首使用。","目標的一條腿變得比另一條長，使它的步行速度降低 10 呎。","目標的眼睛變成探照燈，睜開時會以微光照亮 15 呎錐形範圍。","一對羽翼或皮膜翅膀從目標背上長出，使它獲得 30 呎的飛行速度。","目標的耳朵從頭上撕裂脫落並倉皇跑走；目標處於{@condition deafened}狀態。","目標的兩顆牙齒變成獠牙。","目標的皮膚長滿痂皮，使它的 AC 獲得 +1 加值，但魅力減少 2（最低為 1）。","目標的手臂與腿互換位置，使目標除了爬行之外無法移動。","目標的手臂變成末端長著手指的觸手，使它的觸及增加 5 呎。","目標的腿變得極長又有彈性，使它的步行速度提升 10 呎。",null,null,"目標身體腫脹，體重變為三倍。","目標變得骨瘦如柴，體重減半。","目標的頭變成兩倍大。","目標的耳朵變成翅膀，使它獲得 5 呎的飛行速度。",null,"目標長出另一顆頭，使它對抗{@condition charmed}、{@condition frightened}或{@condition stunned}的豁免檢定具有優勢。"],["極端嚴寒",null],["極端酷熱",null],[null,null],[null,null],[null,null,null,"升環效果",null],[null,null,null],[null,null,null],["冰水",null],[null,null,null,null,null],["綠軟泥",null,null,null,null],[null,null],["大雨",null],["高海拔",null,null],[null,null],["即興傷害",null,null,"傷害","範例",null,null,null,null,null,null,null,null,null,null,null,"5（{@damage 1d10}）","11（{@damage 2d10}）","11（{@damage 2d10}）","22（{@damage 4d10}）","22（{@damage 4d10}）","55（{@damage 10d10}）","55（{@damage 10d10}）","99（{@damage 18d10}）",null,null],[null,null,null,null],[null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null],[null,null,null],["位面效果",null,null,null,null,null,null,null,null,null,null,null],[null,null,null,"升環效果",null,"等級","毒素傷害","豁免 DC","11（{@damage 2d10}）","22（{@damage 4d10}）","55（{@damage 10d10}）"],[null,null,null],[null,null,null,"升環效果",null,"等級","陷坑深度",null,"15 呎",null,null,null,"30 呎",null],["剃刀藤",null,null],[null,null,null,null,null],[null,null,null,null,"升環效果",null],[null,null,null,null,null,null],["赤褐黴菌",null,"這些以赤褐黴菌聞名的蕈類呈現紅棕色，且只會在黑暗、溫暖而潮濕的場所被發現。散佈在金屬物體上的赤褐黴菌很容易被誤認自然形成的鐵鏽，且在這種情況下，必須成功通過一次DC 15的智力（{@skill Nature||自然}）或感知（{@skill Survival||求生}）檢定才能用視覺準確地辨認出來。",null,null,null,null],[null,null,